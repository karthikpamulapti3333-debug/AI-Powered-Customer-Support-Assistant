# Flask Secret Keys
SECRET_KEY=super-secret-flask-key-change-in-production
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production

# Database Settings (PostgreSQL in Production, SQLite locally if empty)
DATABASE_URL=sqlite:///resolveai.db

# Configurable AI LLM Settings
AI_PROVIDER=LOCAL_SIMULATOR  # Choices: OPENAI, GEMINI, OLLAMA, LOCAL_SIMULATOR
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-3.5-turbo

# Environment Setup
FLASK_ENV=development
